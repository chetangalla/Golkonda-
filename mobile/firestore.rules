rules_version = '2';

// Paste this into Firebase Console → Firestore Database → Rules → Publish.
//
// Model: anyone with an account can READ tour content (monuments, GPS
// targets, directions, indoor exhibits) — that's the whole app. Only an
// account with a matching document in `admins/{uid}` can WRITE any of it.
// There is no way to grant yourself admin from inside the app — that
// collection can only be written by hand in the Firebase Console, which is
// the point: it's the one thing a public app build can never self-escalate.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Every visitor's own profile (name/email/phone from sign-up, plus
    // accessExpiresAt once they redeem a code — see accessCodes below).
    // Known gap: because this allows the owner to write ANY field on their
    // own doc, a technically determined visitor could set accessExpiresAt
    // directly, bypassing a code entirely. Rules alone can't fully close
    // this without a Cloud Function doing the write server-side instead —
    // acceptable for a cash-based pilot, worth closing before this becomes
    // the permanent access model.
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Admin roster. Readable only by the account it's about (so the app can
    // check "am I admin?"); never writable from a client.
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Tour content — readable by any signed-in visitor, editable by admins only.
    match /monuments/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /targets/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /gps_directions/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /indoor_exhibits/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Cash-based access codes. `get` (fetch one code you already know) is
    // open to any signed-in visitor — that's how redemption checks a code
    // exists — but `list` (query the whole collection) is admin-only, so a
    // visitor can never browse for unused codes instead of paying for one.
    // The `update` rule only permits exactly the shape a real redemption
    // takes: flipping used false→true, claiming it under your own uid, and
    // leaving the granted duration untouched.
    match /accessCodes/{code} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isSignedIn()
        && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.redeemedBy == request.auth.uid
        && request.resource.data.durationHours == resource.data.durationHours;
      allow delete: if isAdmin();
    }
  }
}
